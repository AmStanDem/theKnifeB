<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<BorderPane prefHeight="768.0"
            prefWidth="1024.0"
            styleClass="root"
            stylesheets="@../styles/scriviRecensione.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.uninsubria.clientTK.controller.ScriviRispostaController">

    <!-- CONTENUTO CENTRALE -->
    <center>
        <StackPane alignment="CENTER">

            <children>

                <VBox alignment="CENTER"
                      spacing="20.0"
                      maxWidth="650.0">

                    <!-- TITOLO -->
                    <Label text="Rispondi"
                           styleClass="profile-title" />

                    <!-- TEXT AREA RECENSIONE -->
                    <TextArea fx:id="txtRecensione"
                              promptText="Scrivi qui la tua risposta..."
                              wrapText="true"
                              prefWidth="600.0"
                              prefHeight="300.0"
                              maxWidth="600.0"
                              maxHeight="300.0"
                              styleClass="review-text-area" />


                    <!-- RIGA BOTTONI AFFIANCATI E SEPARATI -->
                    <HBox alignment="CENTER" spacing="20.0">
                        <children>
                            <Button fx:id="btnInviaRisposta"
                                    mnemonicParsing="false"
                                    onAction="#onInviaRispostaClick"
                                    prefHeight="50.0"
                                    prefWidth="220.0"
                                    styleClass="profile-button"
                                    text="Rispondi" />

                            <Button fx:id="btnAnnulla"
                                    mnemonicParsing="false"
                                    onAction="#onAnnullaClick"
                                    prefHeight="50.0"
                                    prefWidth="180.0"
                                    styleClass="cancel-button"
                                    text="Annulla" />
                        </children>
                    </HBox>

                </VBox>

            </children>

        </StackPane>
    </center>

</BorderPane>
