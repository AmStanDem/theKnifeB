<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<BorderPane prefHeight="768.0"
            prefWidth="1024.0"
            styleClass="root"
            stylesheets="@../styles/areaUtente.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.uninsubria.clientTK.controller.AreaClienteController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20.0"
              styleClass="header"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15.0"
                        left="25.0"
                        right="25.0"
                        top="15.0" />
            </padding>

            <children>

                <!-- LOGO A SINISTRA -->
                <ImageView fitHeight="133.0"
                           fitWidth="441.0"
                           preserveRatio="true"
                           onMouseClicked="#handleLogoClick">

                    <image>
                        <Image url="@../../../../images/img_1.png" />
                    </image>

                </ImageView>

                <!-- SPAZIO -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- LOGOUT -->
                <Button fx:id="btnLogOut"
                        mnemonicParsing="false"
                        onAction="#onLogOutClick"
                        prefHeight="63.0"
                        prefWidth="285.0"
                        styleClass="accent"
                        text="Log out" />


            </children>

        </HBox>
    </top>


    <!-- CONTENUTO CENTRALE -->
    <center>
        <StackPane alignment="CENTER">

            <children>

                <VBox alignment="CENTER"
                      spacing="15.0"
                      maxWidth="550.0">

                    <!-- TITOLO -->
                    <Label text="Il mio profilo"
                           styleClass="profile-title" />

                    <!-- INFORMAZIONI UTENTE -->
                    <VBox spacing="10.0"
                          styleClass="profile-container">

                        <!-- NOME -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Nome:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblNome"
                                   text="Nome utente"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- COGNOME -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Cognome:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblCognome"
                                   text="Cognome utente"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- RUOLO -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Ruolo:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblRuolo"
                                   text="Cliente"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- EMAIL -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Email:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblEmail"
                                   text="email@example.com"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- PASSWORD -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Password:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblPassword"
                                   text="********"
                                   styleClass="profile-value" />
                        </HBox>

                    </VBox>

                    <!-- SPAZIO -->
                    <Region prefHeight="10.0" />

                    <!-- RISTORANTI PREFERITI -->
                    <Button fx:id="btnPreferiti"
                            mnemonicParsing="false"
                            onAction="#onPreferitiClick"
                            prefHeight="55.0"
                            prefWidth="500.0"
                            styleClass="profile-button"
                            text="I miei ristoranti preferiti" />

                    <!-- RECENSIONI -->
                    <Button fx:id="btnRecensioni"
                            mnemonicParsing="false"
                            onAction="#onRecensioniClick"
                            prefHeight="55.0"
                            prefWidth="500.0"
                            styleClass="profile-button"
                            text="Le mie recensioni" />

                </VBox>

            </children>

        </StackPane>
    </center>

</BorderPane>

