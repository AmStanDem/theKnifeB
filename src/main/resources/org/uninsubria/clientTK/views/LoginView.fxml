<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox stylesheets="@../styles/login-style.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.uninsubria.clientTK.controller.LoginController"
      prefWidth="1200" prefHeight="750">

    <!-- ================= LEFT PANEL – FORM ================= -->
    <VBox styleClass="left-panel" HBox.hgrow="ALWAYS" alignment="TOP_LEFT" spacing="0">
        <padding>
            <Insets top="40" right="90" bottom="40" left="90"/>
        </padding>

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <ImageView fitWidth="34" fitHeight="34" preserveRatio="true">
                <Image url="/images/img.png"/>
            </ImageView>
            <Label styleClass="logo-text" text="TheGreenKitchen"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS" prefHeight="50" maxHeight="90"/>

        <!-- Title -->
        <Label styleClass="title-label" text="Welcome back"/>
        <Label styleClass="subtitle-label" text="Please enter your details">
            <VBox.margin>
                <Insets top="8" bottom="30"/>
            </VBox.margin>
        </Label>

        <!-- Email -->
        <Label styleClass="field-label" text="Email address"/>
        <TextField fx:id="emailField" styleClass="text-input" promptText="">
            <VBox.margin>
                <Insets top="6" bottom="22"/>
            </VBox.margin>
        </TextField>

        <!-- Password -->
        <Label styleClass="field-label" text="Password"/>
        <PasswordField fx:id="passwordField" styleClass="text-input" promptText="">
            <VBox.margin>
                <Insets top="6" bottom="18"/>
            </VBox.margin>
        </PasswordField>


        <!-- Sign in button -->
        <Button fx:id="signInButton" styleClass="sign-in-button" text="Sign in" maxWidth="Infinity"
                onAction="#handleSignIn">
            <VBox.margin>
                <Insets bottom="14"/>
            </VBox.margin>
        </Button>



        <!-- Sign up -->
        <HBox alignment="CENTER" spacing="6">
            <Label styleClass="signup-label" text="Don't have an account?"/>
            <Hyperlink styleClass="signup-link" text="Sign up"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>
    </VBox>

    <!-- ================= RIGHT PANEL – ILLUSTRATION ================= -->
    <StackPane styleClass="right-panel" prefWidth="560" HBox.hgrow="NEVER">
        <VBox alignment="CENTER" spacing="24">
            <StackPane styleClass="illustration-circle" prefWidth="240" prefHeight="240">
                <ImageView fitWidth="240" fitHeight="240" preserveRatio="true">
                    <Image url="/images/img_1.png"/>
                </ImageView>
            </StackPane>
            <Label styleClass="illustration-text" text="Fresh ingredients, honest recipes" wrapText="true"
                   textAlignment="CENTER" maxWidth="320"/>
        </VBox>
    </StackPane>

</HBox>
