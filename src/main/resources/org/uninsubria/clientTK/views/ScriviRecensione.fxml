<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<!-- Importazione del RatingContainer personalizzato -->
<?import org.uninsubria.clientTK.util.stars.RatingContainer?>

<BorderPane prefHeight="768.0"
            prefWidth="1024.0"
            styleClass="root"
            stylesheets="@../styles/scriviRecensione.css"
            xmlns="http://javafx.com/fxml/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.uninsubria.clientTK.controller.ScriviRecensioneController">

    <!-- CONTENUTO CENTRALE -->
    <center>
        <StackPane alignment="CENTER">

            <children>

                <VBox alignment="CENTER"
                      spacing="20.0"
                      maxWidth="650.0">

                    <!-- TITOLO -->
                    <Label fx:id="titoloLabel"
                           text="Scrivi una recensione"
                           styleClass="profile-title" />

                    <!-- TEXT AREA RECENSIONE -->
                    <TextArea fx:id="txtRecensione"
                              promptText="Scrivi qui la tua recensione..."
                              wrapText="true"
                              prefWidth="600.0"
                              minHeight="180.0"
                              prefHeight="220.0"
                              maxWidth="600.0"
                              maxHeight="300.0"
                              styleClass="review-text-area" />

                    <!-- STELLE RACCHIUSE NEL RATING CONTAINER -->
                    <RatingContainer fx:id="ratingRecensione"
                                     minHeight="44.0"
                                     prefHeight="44.0"
                                     maxHeight="44.0"
                                     styleClass="review-rating" />

                    <!-- RIGA BOTTONI AFFIANCATI E SEPARATI -->
                    <HBox alignment="CENTER" spacing="20.0">
                        <children>
                            <Button fx:id="btnInviaRecensione"
                                    mnemonicParsing="false"
                                    onAction="#onInviaRecensioneClick"
                                    prefHeight="50.0"
                                    prefWidth="220.0"
                                    styleClass="profile-button"
                                    text="Invia recensione" />

                            <Button fx:id="btnAnnulla"
                                    mnemonicParsing="false"
                                    onAction="#onAnnullaClick"
                                    prefHeight="50.0"
                                    prefWidth="180.0"
                                    styleClass="cancel-button"
                                    text="Annulla" />
                        </children>
                    </HBox>

                </VBox>

            </children>

        </StackPane>
    </center>

</BorderPane>