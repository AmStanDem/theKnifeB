<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import org.controlsfx.control.Rating?>

<BorderPane prefHeight="768.0"
            prefWidth="1024.0"
            styleClass="root"
            stylesheets="@../styles/scriviRecensione.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.uninsubria.clientTK.controller.ScriviRecensioneController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20.0"
              styleClass="header"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15.0"
                        left="25.0"
                        right="25.0"
                        top="15.0" />
            </padding>

            <children>

                <!-- LOGO A SINISTRA -->
                <ImageView fitHeight="133.0"
                           fitWidth="441.0"
                           preserveRatio="true"
                           onMouseClicked="#handleLogoClick">

                    <image>
                        <Image url="@../../../../images/img_1.png" />
                    </image>

                </ImageView>

                <!-- SPAZIO -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- LOGOUT -->
                <Button fx:id="btnLogOut"
                        mnemonicParsing="false"
                        onAction="#onLogOutClick"
                        prefHeight="63.0"
                        prefWidth="285.0"
                        styleClass="accent"
                        text="Log out" />


            </children>

        </HBox>
    </top>


    <!-- CONTENUTO CENTRALE -->
    <center>
        <StackPane alignment="CENTER">

            <children>

                <VBox alignment="CENTER"
                      spacing="20.0"
                      maxWidth="650.0">

                    <!-- TITOLO -->
                    <Label text="Scrivi una recensione"
                           styleClass="profile-title" />

                    <!-- TEXT AREA RECENSIONE -->
                    <TextArea fx:id="txtRecensione"
                              promptText="Scrivi qui la tua recensione..."
                              wrapText="true"
                              prefWidth="600.0"
                              prefHeight="300.0"
                              maxWidth="600.0"
                              maxHeight="300.0"
                              styleClass="review-text-area" />

                    <!-- STELLE -->
                    <Rating fx:id="ratingRecensione"
                            max="5"
                            partialRating="false"
                            rating="0"
                            styleClass="review-rating" />

                    <!-- RIGA BOTTONI AFFIANCATI E SEPARATI -->
                    <HBox alignment="CENTER" spacing="20.0">
                        <children>
                            <Button fx:id="btnInviaRecensione"
                                    mnemonicParsing="false"
                                    onAction="#onInviaRecensioneClick"
                                    prefHeight="50.0"
                                    prefWidth="220.0"
                                    styleClass="profile-button"
                                    text="Invia recensione" />

                            <Button fx:id="btnAnnulla"
                                    mnemonicParsing="false"
                                    onAction="#onAnnullaClick"
                                    prefHeight="50.0"
                                    prefWidth="180.0"
                                    styleClass="cancel-button"
                                    text="Annulla" />
                        </children>
                    </HBox>

                </VBox>

            </children>

        </StackPane>
    </center>

</BorderPane>

