<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<BorderPane prefHeight="768.0"
            prefWidth="1024.0"
            styleClass="root"
            stylesheets="@../styles/areaUtente.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.uninsubria.clientTK.controller.AreaClienteController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20.0"
              styleClass="header"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15.0"
                        left="25.0"
                        right="25.0"
                        top="15.0" />
            </padding>

            <children>

                <!-- LOGO A SINISTRA -->
                <ImageView fitHeight="133.0"
                           fitWidth="441.0"
                           preserveRatio="true">

                    <image>
                        <Image url="@../../../../images/img_1.png" />
                    </image>

                </ImageView>

                <!-- SPAZIO -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- LOGOUT -->
                <Button fx:id="btnLogOut"
                        mnemonicParsing="false"
                        onAction="#onLogOutClick"
                        prefHeight="63.0"
                        prefWidth="285.0"
                        styleClass="accent"
                        text="Log out" />


            </children>

        </HBox>
    </top>


    <!-- CONTENUTO CENTRALE -->
    <center>
        <StackPane alignment="CENTER">

            <children>

                <VBox alignment="CENTER"
                      spacing="15.0"
                      maxWidth="550.0">

                    <!-- TITOLO -->
                    <Label text="Informazioni ristorante"
                           styleClass="profile-title" />

                    <!-- INFORMAZIONI RISTORANTE -->
                    <VBox spacing="10.0"
                          styleClass="profile-container">

                        <!-- NOME RISTORANTE -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Nome:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblNomeRistorante"
                                   text="Nome del ristorante"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- NAZIONE -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Nazione:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblNazione"
                                   text="Italia"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- CITTÀ -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Città:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblCitta"
                                   text="Milano"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- INDIRIZZO -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Indirizzo:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblIndirizzo"
                                   text="Via Roma 10"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- LATITUDINE -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Latitudine:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblLatitudine"
                                   text="45.4642"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- LONGITUDINE -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Longitudine:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblLongitudine"
                                   text="9.1900"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- FASCIA DI PREZZO -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Prezzo medio:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblFasciaPrezzo"
                                   text="25,00 €"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- DELIVERY -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Delivery:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblDelivery"
                                   text="Sì"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- PRENOTAZIONE ONLINE -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Prenotazione:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblPrenotazione"
                                   text="Sì"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- TIPO DI CUCINA -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Tipo di cucina:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblTipoCucina"
                                   text="Italiana"
                                   styleClass="profile-value" />
                        </HBox>

                    </VBox>

                    <!-- SPAZIO -->
                    <Region prefHeight="10.0" />

                </VBox>

            </children>

        </StackPane>
    </center>

</BorderPane>

