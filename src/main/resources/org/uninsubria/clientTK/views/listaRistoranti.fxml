<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.uninsubria.clientTK.controller.ListaRistorantiController"
            stylesheets="@../styles/lista-ristoranti.css"
            styleClass="root-pane"
            prefWidth="1100" prefHeight="750">

    <!-- HEADER: titolo + barra di ricerca -->
    <top>
        <VBox spacing="16" styleClass="header-box">
            <padding>
                <Insets top="24" right="32" bottom="16" left="32"/>
            </padding>

            <Label text="Trova il tuo ristorante" styleClass="page-title"/>

            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="search-bar">
                <TextField fx:id="searchField"
                           promptText="Cerca per nome, indirizzo o cucina..."
                           styleClass="search-field"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="searchButton"
                        text="Cerca"
                        styleClass="primary-button"
                        onAction="#onSearch"/>
            </HBox>

            <!-- FILTRI -->
            <HBox spacing="16" alignment="CENTER_LEFT" styleClass="filters-bar">
                <Label text="Filtri:" styleClass="filters-label"/>

                <ComboBox fx:id="priceFilterCombo"
                          promptText="Fascia di prezzo"
                          styleClass="filter-combo"
                          onAction="#onFilterChanged"/>

                <ComboBox fx:id="ratingFilterCombo"
                          promptText="Rating minimo"
                          styleClass="filter-combo"
                          onAction="#onFilterChanged"/>

                <ComboBox fx:id="cuisineFilterCombo"
                          promptText="Tipo di cucina"
                          styleClass="filter-combo"
                          onAction="#onFilterChanged"/>

                <Button fx:id="resetFiltersButton"
                        text="Azzera filtri"
                        styleClass="secondary-button"
                        onAction="#onResetFilters"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTRO: lista ristoranti (ScrollPane + VBox) -->
    <center>
        <VBox styleClass="content-box">
            <padding>
                <Insets top="8" right="32" bottom="24" left="32"/>
            </padding>

            <Label fx:id="resultsCountLabel"
                   text="0 ristoranti trovati"
                   styleClass="results-count"/>

            <ScrollPane fx:id="restaurantScrollPane"
                        styleClass="restaurant-scroll-pane"
                        fitToWidth="true"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="restaurantContainer"
                          spacing="14"
                          styleClass="restaurant-container"/>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>