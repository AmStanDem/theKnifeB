<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane prefHeight="768.0" prefWidth="1024.0"
            style="-fx-background-color: -color-bg-default;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.uninsubria.clientTK.controller.MainLayoutController">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20.0"
              style="-fx-background-color: #1A1A1E;"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15.0"
                        left="25.0"
                        right="25.0"
                        top="15.0" />
            </padding>

            <children>

                <ImageView fitHeight="133.0"
                           fitWidth="441.0"
                           preserveRatio="true">
                    <image>
                        <Image url="/images/img_1.png" />
                    </image>
                </ImageView>

                <Region HBox.hgrow="ALWAYS" />

            </children>
        </HBox>
    </top>

    <left>
        <AnchorPane prefHeight="605.0"
                    prefWidth="1019.0"
                    BorderPane.alignment="CENTER">

            <children>

                <Button layoutX="357.0"
                        layoutY="202.0"
                        mnemonicParsing="false"
                        onAction="#onRicercaClick"
                        prefHeight="65.0"
                        prefWidth="286.0"
                        styleClass="flat"
                        text="Esplora" />

                <Button layoutX="357.0"
                        layoutY="303.0"
                        mnemonicParsing="false"
                        onAction="#onRicercaClick"
                        prefHeight="65.0"
                        prefWidth="286.0"
                        styleClass="flat"
                        text="Cerca" />

                <Button fx:id="btnAreaPersonale"
                        layoutX="357.0"
                        layoutY="415.0"
                        mnemonicParsing="false"
                        onAction="#onAreaPersonaleClick"
                        prefHeight="63.0"
                        prefWidth="285.0"
                        styleClass="accent"
                        text="Accedi / Registrati" />

            </children>
        </AnchorPane>
    </left>

</BorderPane>