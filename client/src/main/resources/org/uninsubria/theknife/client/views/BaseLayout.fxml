<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<BorderPane styleClass="base-layout"
            stylesheets="@../styles/main-layout.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.uninsubria.clientTK.controller.BaseLayoutController"
            prefHeight="768.0"
            prefWidth="1024.0">

        <!-- HEADER -->
        <top>
            <HBox alignment="CENTER_LEFT"
                  spacing="20.0"
                  styleClass="header"
                  BorderPane.alignment="CENTER">

                <padding>
                    <Insets bottom="15.0"
                            left="25.0"
                            right="25.0"
                            top="15.0" />
                </padding>

                <children>

                    <Button fx:id="btnBack"
                            text="←"
                            accessibleText="Torna alla pagina precedente"
                            onAction="#goBack"
                            styleClass="back-button" />

                    <!-- LOGO -->
                    <ImageView fitHeight="133.0"
                               fitWidth="441.0"
                               preserveRatio="true"
                               onMouseClicked="#handleLogoClick">
                        <image>
                            <Image url="@../../../../images/img_1.png" />
                        </image>
                    </ImageView>

                    <!-- SPAZIO -->
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- PULSANTE PER UTENTE NON LOGGATO -->
                    <Button fx:id="btnAccediRegistrati"
                            mnemonicParsing="false"
                            onAction="#onAreaPersonaleClick"
                            prefHeight="63.0"
                            prefWidth="285.0"
                            styleClass="accent"
                            text="Accedi" />

                    <!-- IMMAGINE PER UTENTE LOGGATO -->
                    <ImageView fx:id="imgUtente"
                               fitHeight="70.0"
                               fitWidth="70.0"
                               preserveRatio="true"
                               onMouseClicked="#onAreaPersonaleLoggatoClick"
                               visible="false"
                               managed="false">
                        <image>
                            <Image url="@../../../../images/user.png" />
                        </image>
                    </ImageView>

                </children>
            </HBox>
        </top>
    <center>
        <StackPane fx:id="contentContainer" />
    </center>
</BorderPane>
