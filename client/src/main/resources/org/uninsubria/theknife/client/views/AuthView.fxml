<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.uninsubria.theknife.client.util.LuogoInput?>
<?import org.uninsubria.theknife.client.util.components.DataNascitaInput?>
<?import org.uninsubria.theknife.client.util.components.HomeLogo?>

<HBox prefHeight="750" prefWidth="1200" stylesheets="@../styles/login-style.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uninsubria.theknife.client.controller.AuthController">

    <!-- ================= LEFT PANEL – FORM ================= -->
    <VBox alignment="TOP_LEFT" spacing="0" styleClass="left-panel" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="40" left="90" right="90" top="40" />
        </padding>

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="10" />

        <Region maxHeight="142.0" prefHeight="61.0" prefWidth="460.0" VBox.vgrow="ALWAYS" />

        <!-- ========== PANNELLO LOGIN ========== -->
        <VBox fx:id="loginFields" spacing="0" managed="true" visible="true">

            <!-- Title -->
            <Label styleClass="title-label" text="Bentornato su TheKnife" />
            <Label styleClass="subtitle-label" text="Inserisci le tue credenziali">
                <VBox.margin>
                    <Insets bottom="30" top="8" />
                </VBox.margin>
            </Label>

            <!-- Email -->
            <Label styleClass="field-label" text="E-mail" />
            <TextField fx:id="campoEmail" promptText="Inserisci la tua e-mail" styleClass="text-input">
                <VBox.margin>
                    <Insets bottom="22" top="6" />
                </VBox.margin>
            </TextField>

            <!-- Password -->
            <Label styleClass="field-label" text="Password" />
            <PasswordField fx:id="campoPassword" promptText="Inserisci la password" styleClass="text-input">
                <VBox.margin>
                    <Insets bottom="18" top="6" />
                </VBox.margin>
            </PasswordField>

            <!-- Messaggio di errore -->
            <Label fx:id="labelErrore" styleClass="error-label" wrapText="true" />

            <!-- Sign in button -->
            <Button fx:id="signInButton" maxWidth="Infinity" onAction="#onAccedi" styleClass="sign-in-button" text="Accedi">
                <VBox.margin>
                    <Insets bottom="14" />
                </VBox.margin>
            </Button>

            <!-- Sign up link -->
            <HBox alignment="CENTER" spacing="6">
                <Label styleClass="signup-label" text="Non hai ancora un account?" />
                <Hyperlink styleClass="signup-link" text="Registrati" onAction="#onVaiRegistrazione" />
            </HBox>
        </VBox>

        <!-- ========== PANNELLO REGISTRAZIONE ========== -->
        <VBox fx:id="registrazioneFields" spacing="0" managed="false" visible="false" maxHeight="Infinity">
            <padding>
                <Insets bottom="10.0" />
            </padding>

            <!-- Title -->
            <Label styleClass="title-label" text="Crea il tuo account" />

            <!-- NOME -->
            <VBox spacing="4.0">
                <VBox.margin>
                    <Insets top="20.0" />
                </VBox.margin>
                <Label styleClass="field-label" text="Nome" />
                <TextField fx:id="nomeField" prefHeight="40.0" promptText="Inserisci il nome" />
                <Label fx:id="nomeErrore" managed="false" styleClass="field-error" visible="false" wrapText="true" />
            </VBox>

            <!-- COGNOME -->
            <VBox spacing="4.0">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
                <Label styleClass="field-label" text="Cognome" />
                <TextField fx:id="cognomeField" prefHeight="40.0" promptText="Inserisci il cognome" />
                <Label fx:id="cognomeErrore" managed="false" styleClass="field-error" visible="false" wrapText="true" />
            </VBox>

            <!-- DATA DI NASCITA -->
            <VBox spacing="4.0">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
                <Label styleClass="field-label" text="Data di nascita (opzionale)" />
                <DataNascitaInput fx:id="dataNascitaField" prefHeight="40.0" />
                <Label fx:id="dataNascitaErrore" managed="false" styleClass="field-error" visible="false" wrapText="true" />
            </VBox>

            <!-- DOMICILIO -->
            <VBox spacing="4.0">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
                <Label styleClass="field-label" text="Domicilio" />
                <LuogoInput fx:id="indirizzo" prefHeight="40.0"
                            promptText="Cerca e seleziona il tuo domicilio" />
                <Label fx:id="domicilioErrore" managed="false" styleClass="field-error" visible="false" wrapText="true" />
            </VBox>

            <!-- RUOLO -->
            <VBox spacing="4.0">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
                <Label styleClass="field-label" text="Ruolo" />
                <ComboBox fx:id="ruoloComboBox" maxWidth="Infinity" prefHeight="40.0" promptText="Seleziona il ruolo">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Cliente" />
                            <String fx:value="Ristoratore" />
                        </FXCollections>
                    </items>
                </ComboBox>
                <Label fx:id="ruoloErrore" managed="false" styleClass="field-error" visible="false" wrapText="true" />
            </VBox>

            <!-- EMAIL -->
            <VBox spacing="4.0">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
                <Label styleClass="field-label" text="E-mail" />
                <TextField fx:id="emailField" prefHeight="40.0" promptText="Inserisci l'e-mail" />
                <Label fx:id="emailErrore" managed="false" styleClass="field-error" visible="false" wrapText="true" />
            </VBox>

            <!-- PASSWORD -->
            <VBox spacing="4.0">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
                <Label styleClass="field-label" text="Password" />
                <PasswordField fx:id="passwordField" prefHeight="40.0" promptText="Inserisci la password" />
                <Label styleClass="hint-label" text="&#9432; La password deve avere almeno 8 caratteri, un numero, una maiuscola e una minuscola e un carattere speciale" wrapText="true" />
                <Label fx:id="passwordErrore" managed="false" styleClass="field-error" visible="false" wrapText="true" />
            </VBox>

            <!-- CONFERMA PASSWORD -->
            <VBox spacing="4.0">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
                <Label styleClass="field-label" text="Conferma password" />
                <PasswordField fx:id="confermaPasswordField" prefHeight="40.0" promptText="Ripeti la password" />
                <Label fx:id="confermaPasswordErrore" managed="false" styleClass="field-error" visible="false" wrapText="true" />
            </VBox>

            <!-- Messaggio di errore (condiviso con login) -->
            <!-- labelErrore è già definito sopra nel pannello login,
                 ma lo usiamo anche per la registrazione -->
            <Region prefHeight="10.0" />

            <!-- Registrati button -->
            <Button fx:id="registratiButton" maxWidth="Infinity" onAction="#gestisciRegistrazione" prefHeight="45.0" styleClass="sign-in-button" text="Registrati">
                <VBox.margin>
                    <Insets bottom="14.0" top="8.0" />
                </VBox.margin>
            </Button>

            <!-- Login link -->
            <HBox alignment="CENTER" spacing="6">
                <Label styleClass="signup-label" text="Hai già un account?" />
                <Label onMouseClicked="#onVaiLogin" styleClass="signup-link" text="Accedi" />
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />
    </VBox>

    <!-- ================= RIGHT PANEL – ILLUSTRATION ================= -->
    <StackPane prefWidth="560" styleClass="right-panel" HBox.hgrow="NEVER">
        <VBox alignment="CENTER" spacing="24">
            <StackPane prefHeight="240" prefWidth="240" styleClass="illustration-circle">
            <children>
                  <HomeLogo fitHeight="249.0" fitWidth="416.0" />
            </children>
            </StackPane>
            <Label maxWidth="320" styleClass="illustration-text" text="Ingredienti freschi, ricette genuine" textAlignment="CENTER" wrapText="true" />
        </VBox>
    </StackPane>

</HBox>