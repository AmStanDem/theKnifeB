<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import org.controlsfx.control.RangeSlider?>
<?import org.uninsubria.theknife.client.util.LuogoInput?>
<?import org.uninsubria.theknife.client.util.stars.RatingContainer?>

<!--
    Pagina di Ricerca Avanzata - TheKnife (Formato Orizzontale)
    Controller di riferimento: RicercaAvanzataController
-->
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane
            prefHeight="768.0"
            prefWidth="1024.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.uninsubria.theknife.client.controller.RicercaAvanzataController"
            stylesheets="@../styles/ricerca-avanzata.css"
            styleClass="root-pane">

    <!-- ===================== HEADER ===================== -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20.0"
              styleClass="header-bar"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15.0"
                        left="25.0"
                        right="25.0"
                        top="15.0" />
            </padding>

            <children>

                <!-- LOGO A SINISTRA -->
                <ImageView fitHeight="133.0"
                           fitWidth="441.0"
                           preserveRatio="true"
                           onMouseClicked="#handleLogoClick">

                    <image>
                        <Image url="@../images/img_1.png" />
                    </image>

                </ImageView>
            </children>

        </HBox>
    </top>



    <!-- ===================== CONTENUTO ===================== -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-container">
            <VBox alignment="CENTER" spacing="24" styleClass="form-container">
                <padding>
                    <Insets top="28" right="36" bottom="36" left="36"/>
                </padding>

                <Label text="Trova il ristorante perfetto per te" styleClass="page-title"/>

                <!-- Card contenitore del form (Layout Orizzontale) -->
                <VBox spacing="24" styleClass="form-card" maxWidth="1040">
                    <padding>
                        <Insets top="30" right="36" bottom="30" left="36"/>
                    </padding>

                    <!-- Layout a griglia su 2 colonne -->
                    <GridPane hgap="36" vgap="22">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>

                        <!-- COLONNA SINISTRA -->
                        <VBox spacing="20" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <!-- Località (obbligatorio) -->
                            <VBox spacing="6" styleClass="field-group">
                                <Label text="Località *" styleClass="field-label"/>
                                <LuogoInput fx:id="txtLocalita"
                                            prefHeight="40"
                                            promptText="Es. Milano, Via Roma 12, oppure CAP"
                                            styleClass="field-input"/>
                                <Label text="Campo obbligatorio" styleClass="field-hint"/>
                            </VBox>

                            <!-- Tipologia di cucina -->
                            <VBox spacing="6" styleClass="field-group">
                                <Label text="Tipologia di cucina" styleClass="field-label"/>
                                <MenuButton
                                        fx:id="cuisineMenuButton"
                                        text="Tipo di cucina"
                                        maxWidth="Infinity"
                                        styleClass="field-input"
                                />
                            </VBox>
                        </VBox>

                        <!-- COLONNA DESTRA -->
                        <VBox spacing="20" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <!-- Fascia di prezzo -->
                            <VBox spacing="6" styleClass="field-group">
                                <Label text="Fascia di prezzo" styleClass="field-label"/>
                                <RangeSlider fx:id="rangeSliderPrezzo"
                                             min="10" max="350"
                                             lowValue="10" highValue="350"
                                             blockIncrement="5"
                                             majorTickUnit="50"
                                             minorTickCount="9"
                                             snapToTicks="true"
                                             showTickLabels="true"
                                             showTickMarks="true"
                                             styleClass="price-range-slider"/>
                                <HBox spacing="16">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="Inizio range (€)" styleClass="field-label"/>
                                        <TextField fx:id="txtPrezzoMin"
                                                   text="10"
                                                   styleClass="price-input"
                                                   onAction="#aggiornaPrezzoMin"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="Fine range (€)" styleClass="field-label"/>
                                        <TextField fx:id="txtPrezzoMax"
                                                   text="350+"
                                                   styleClass="price-input"
                                                   onAction="#aggiornaPrezzoMax"/>
                                    </VBox>
                                </HBox>
                                <Label text="350+ indica 350 € o più" styleClass="field-hint"/>
                            </VBox>

                            <!-- Valutazione minima (stelle) -->
                            <VBox spacing="6" styleClass="field-group">
                                <Label text="Valutazione minima" styleClass="field-label"/>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <RatingContainer fx:id="ratingStelleMinime"
                                                     styleClass="star-rating"/>
                                    <Label fx:id="lblRatingValore" text="Nessun minimo" styleClass="field-hint"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </GridPane>

                    <Separator/>

                    <!-- SEZIONE INFERIORE: Servizi + Pulsanti affiancati -->
                    <HBox alignment="CENTER_LEFT" spacing="28">
                        <!-- Servizi disponibili -->
                        <VBox spacing="8" styleClass="field-group" HBox.hgrow="ALWAYS">
                            <Label text="Servizi disponibili" styleClass="field-label"/>
                            <HBox spacing="28" alignment="CENTER_LEFT">
                                <CheckBox fx:id="chkDelivery" text="Servizio di delivery" styleClass="field-checkbox"/>
                                <CheckBox fx:id="chkPrenotazione" text="Prenotazione online" styleClass="field-checkbox"/>
                            </HBox>
                        </VBox>

                        <!-- Pulsanti azione -->
                        <HBox spacing="12" alignment="BOTTOM_RIGHT" styleClass="button-bar">
                            <Button fx:id="btnReimposta"
                                    text="Reimposta"
                                    onAction="#reimpostaFiltri"
                                    styleClass="btn-secondary"/>
                            <Button fx:id="btnCerca"
                                    text="Cerca"
                                    onAction="#cercaRistorante"
                                    defaultButton="true"
                                    styleClass="btn-primary"/>
                        </HBox>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>