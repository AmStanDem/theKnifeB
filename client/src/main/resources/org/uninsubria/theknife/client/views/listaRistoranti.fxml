<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ProgressIndicator?>
<?import org.uninsubria.theknife.client.util.components.CuisineSelector?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.uninsubria.theknife.client.controller.ListaRistorantiController"
            stylesheets="@../styles/lista-ristoranti.css"
            styleClass="root-pane"
            prefWidth="1100" prefHeight="750">

    <!-- HEADER: titolo + barra di ricerca -->
    <top>
        <VBox spacing="16" styleClass="header-box">
            <padding>
                <Insets top="24" right="32" bottom="16" left="32"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="title-bar">
                <Label text="Trova il tuo ristorante" styleClass="page-title" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="search-bar">
                <TextField fx:id="searchField"
                           promptText="Cerca per nome, indirizzo o cucina..."
                           styleClass="search-field"
                           onAction="#cerca"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="searchButton"
                        text="Cerca"
                        styleClass="primary-button"
                        onAction="#cerca"/>
            </HBox>

            <Label fx:id="locationFilterLabel" text="Posizione: ovunque" styleClass="filters-label"/>

            <!-- FILTRI -->
            <HBox spacing="16" alignment="CENTER_LEFT" styleClass="filters-bar">
                <Label text="Filtri:" styleClass="filters-label"/>

                <ComboBox fx:id="priceFilterCombo"
                          styleClass="filter-combo"
                          onAction="#filtriCambiati"/>

                <ComboBox fx:id="ratingFilterCombo"
                          styleClass="filter-combo"
                          onAction="#filtriCambiati"/>

                <CheckBox fx:id="deliveryFilterCheckBox"
                          text="Consegna a domicilio"
                          styleClass="service-filter-checkbox"
                          onAction="#filtriCambiati"/>

                <CheckBox fx:id="bookingOnlineFilterCheckBox"
                          text="Prenotazione online"
                          styleClass="service-filter-checkbox"
                          onAction="#filtriCambiati"/>

                <!-- MenuButton per selezione multipla cucine -->
                <CuisineSelector fx:id="cuisineSelector"
                            text="Tipo di cucina"
                            styleClass="filter-combo">
                </CuisineSelector>

                <Button fx:id="resetFiltersButton"
                        text="Azzera filtri"
                        styleClass="secondary-button"
                        onAction="#reimpostaFiltri"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTRO: lista ristoranti (ScrollPane + VBox) -->
    <center>
        <VBox styleClass="content-box">
            <padding>
                <Insets top="8" right="32" bottom="24" left="32"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="resultsCountLabel"
                       text="0 ristoranti trovati"
                       styleClass="results-count"/>
                <ProgressIndicator fx:id="loadingIndicator"
                                   prefWidth="24" prefHeight="24"
                                   visible="false" managed="false"/>
            </HBox>

            <ScrollPane fx:id="restaurantScrollPane"
                        styleClass="restaurant-scroll-pane"
                        fitToWidth="true"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="restaurantContainer"
                          spacing="14"
                          styleClass="restaurant-container"/>
                </content>
            </ScrollPane>
            <Button fx:id="loadMoreButton"
                    text="Carica altri ristoranti"
                    styleClass="secondary-button"
                    onAction="#caricaAltri"
                    visible="false"
                    managed="false"/>
        </VBox>
    </center>

</BorderPane>