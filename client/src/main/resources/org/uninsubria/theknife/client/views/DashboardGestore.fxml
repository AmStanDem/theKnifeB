<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.uninsubria.theknife.client.controller.DashboardGestoreController"
            stylesheets="@../styles/lista-ristoranti.css"
            styleClass="root-pane"
            prefWidth="1100"
            prefHeight="750">
    <top>
        <VBox styleClass="header-box">
            <padding>
                <Insets top="24" right="32" bottom="16" left="32"/>
            </padding>

            <!-- Intestazione: benvenuto + pulsanti azione -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="title-bar">
                <Label text="Dashboard gestore" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Aggiungi ristorante"
                        styleClass="primary-button"
                        onAction="#onAggiungiClick"/>
                <Button text="Profilo"
                        styleClass="secondary-button"
                        onAction="#onProfiloClick"/>
                <Button text="Logout"
                        styleClass="secondary-button"
                        onAction="#onLogOutClick"/>
            </HBox>

            <!-- Dati utente -->
            <VBox spacing="4" styleClass="user-info-box">
                <padding>
                    <Insets top="12" right="0" bottom="4" left="0"/>
                </padding>
                <HBox spacing="24" alignment="CENTER_LEFT">
                    <HBox spacing="6">
                        <Label text="Nome:" styleClass="user-info-label"/>
                        <Label fx:id="lblNome" text="-" styleClass="user-info-value"/>
                    </HBox>
                    <HBox spacing="6">
                        <Label text="Cognome:" styleClass="user-info-label"/>
                        <Label fx:id="lblCognome" text="-" styleClass="user-info-value"/>
                    </HBox>
                    <HBox spacing="6">
                        <Label text="Email:" styleClass="user-info-label"/>
                        <Label fx:id="lblEmail" text="-" styleClass="user-info-value"/>
                    </HBox>
                    <HBox spacing="6">
                        <Label text="Ruolo:" styleClass="user-info-label"/>
                        <Label fx:id="lblRuolo" text="-" styleClass="user-info-value"/>
                    </HBox>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content-box">
            <padding>
                <Insets top="16" right="32" bottom="24" left="32"/>
            </padding>
            <Label fx:id="resultsCountLabel"
                   text="Caricamento ristoranti..."
                   styleClass="results-count"/>
            <Label fx:id="emptyStateLabel"
                   text="Non hai ancora aggiunto ristoranti."
                   visible="false"
                   managed="false"
                   styleClass="results-count"/>
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        styleClass="restaurant-scroll-pane"
                        VBox.vgrow="ALWAYS">
                <VBox fx:id="restaurantContainer"
                      spacing="14"
                      styleClass="restaurant-container"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>