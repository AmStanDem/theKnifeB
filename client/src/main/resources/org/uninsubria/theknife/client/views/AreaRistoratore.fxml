<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import org.uninsubria.theknife.client.util.components.HomeLogo?>

<BorderPane prefHeight="768.0"
            prefWidth="1024.0"
            styleClass="root"
            stylesheets="@../styles/areaUtente.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.uninsubria.theknife.client.controller.AreaRistoratoreController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20.0"
              styleClass="header"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15.0"
                        left="25.0"
                        right="25.0"
                        top="15.0"/>
            </padding>

            <!-- LOGO A SINISTRA -->
            <HomeLogo/>

            <!-- SPAZIO -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- LOGOUT -->
            <Button fx:id="btnLogOut"
                    mnemonicParsing="false"
                    onAction="#onLogOutClick"
                    prefHeight="63.0"
                    prefWidth="285.0"
                    styleClass="accent"
                    text="Esci"/>


        </HBox>
    </top>


    <!-- CONTENUTO CENTRALE -->
    <center>
        <StackPane alignment="CENTER">

            <children>

                <VBox alignment="CENTER"
                      spacing="15.0"
                      maxWidth="550.0">

                    <!-- TITOLO -->
                    <Label text="Il mio profilo"
                           styleClass="profile-title" />

                    <!-- INFORMAZIONI UTENTE -->
                    <VBox spacing="10.0"
                          styleClass="profile-container">

                        <!-- NOME -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Nome:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblNome"
                                   text="Nome utente"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- COGNOME -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Cognome:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblCognome"
                                   text="Cognome utente"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- RUOLO -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Ruolo:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblRuolo"
                                   text="Ristoratore"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- EMAIL -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="E-mail:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblEmail"
                                   text="email@example.com"
                                   styleClass="profile-value" />
                        </HBox>

                        <!-- PASSWORD -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">
                            <Label text="Password:"
                                   styleClass="profile-label" />

                            <Label fx:id="lblPassword"
                                   text="********"
                                   styleClass="profile-value" />
                        </HBox>

                    </VBox>

                    <!-- SPAZIO -->
                    <Region prefHeight="10.0" />

                    <!-- I MIEI RISTORANTI  -->
                    <Button fx:id="btnRistoranti"
                            mnemonicParsing="false"
                            onAction="#ListaRistorantiRistoratore"
                            prefHeight="55.0"
                            prefWidth="500.0"
                            styleClass="profile-button"
                            text="Gestisci i miei ristoranti" />

                    <!-- AGGIUNGI RISTORANTE -->
                    <Button fx:id="btnAggiungi"
                            mnemonicParsing="false"
                            onAction="#onAggiungiClick"
                            prefHeight="55.0"
                            prefWidth="500.0"
                            styleClass="profile-button"
                            text="Aggiungi ristorante" />

                    <Button fx:id="btnModificaRistorante"
                            mnemonicParsing="false"
                            onAction="#onModificaRistoranteClick"
                            prefHeight="55.0"
                            prefWidth="500.0"
                            styleClass="profile-button"
                            text="Modifica ristorante" />

                    <Button fx:id="btnModificaCredenziali"
                            mnemonicParsing="false"
                            onAction="#onModificaCredenzialiClick"
                            prefHeight="55.0"
                            prefWidth="500.0"
                            styleClass="profile-button"
                            text="Modifica credenziali" />

                </VBox>

            </children>

        </StackPane>
    </center>

</BorderPane>
