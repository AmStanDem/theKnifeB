<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<VBox spacing="10"
      maxWidth="Infinity"
      stylesheets="@../styles/recensione-item.css"
      styleClass="recensione-item"
      xmlns="http://javafx.com/javafx/21.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.uninsubria.theknife.client.controller.RecensioneItemController">

    <!-- Header: Avatar + Autore + Ristorante + Badge -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="author-row">
        <StackPane fx:id="avatarCircle" styleClass="avatar-circle">
            <Circle radius="16" styleClass="avatar-bg"/>
            <Label fx:id="avatarInitial" styleClass="avatar-initial" text="U"/>
        </StackPane>
        <VBox spacing="1">
            <Label fx:id="authorLabel" styleClass="author-name" text="Utente"/>
            <Label fx:id="restaurantLabel" styleClass="restaurant-name" text=""/>
            <Label fx:id="localGuideLabel" styleClass="local-guide-badge" visible="false" managed="false" text="Guida locale"/>
        </VBox>
    </HBox>

    <!-- Riga Stelle + Data -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="rating-row">
        <HBox fx:id="ratingStarsContainer" styleClass="review-rating-small"/>
        <Label fx:id="timeLabel" style="-fx-text-fill: #5f6368; -fx-font-size: 13px;" styleClass="review-time" text="30 luglio 2026" />
    </HBox>

    <!-- Testo recensione -->
    <Label fx:id="reviewTextField"
           maxWidth="Infinity"
           styleClass="review-text-field"
           wrapText="true" />

    <!-- Sezione Risposta -->
    <VBox spacing="4" style="-fx-padding: 8px 0 0 0;">

        <HBox alignment="CENTER_LEFT" spacing="6" styleClass="actions-row">

            <Label fx:id="likeCountLabel"
                   style="-fx-font-size: 11px; -fx-text-fill: #70757a; -fx-font-weight: bold;"
                   styleClass="like-count"
                   text="RISPOSTA" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="editButton"
                    text="Modifica"
                    styleClass="edit-button"
                    onAction="#modificaCliccata"
                    visible="false"
                    managed="false" />

            <Button fx:id="deleteButton"
                    text="Elimina"
                    styleClass="delete-button"
                    onAction="#eliminaCliccato"
                    visible="false"
                    managed="false" />

            <Button fx:id="replyButton"
                    text="Rispondi"
                    styleClass="reply-button"
                    onAction="#rispondiCliccato"
                    visible="false"
                    managed="false" />

        </HBox>

        <Label fx:id="responseTextField"
               maxWidth="Infinity"
               style="-fx-font-size: 13px; -fx-text-fill: #5f6368;"
               styleClass="response-text-field"
               wrapText="true" />

    </VBox>

    <padding>
        <Insets bottom="18" left="22" right="22" top="18" />
    </padding>
</VBox>