<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.uninsubria.theknife.client.util.LuogoInput?>


<BorderPane prefHeight="768.0" prefWidth="1024.0" styleClass="root" stylesheets="@../styles/main-layout.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uninsubria.theknife.client.controller.MainLayoutController">

    <!-- CONTENUTO CENTRALE -->
    <center>
        <StackPane alignment="CENTER">

            <children>

                <!-- CONTENITORE DELLA RICERCA -->
                <VBox alignment="CENTER" spacing="18.0">

                    <!-- TITOLO -->
                    <Label styleClass="search-title" text="Prenota i migliori ristoranti per ogni occasione" />

                    <!-- RIGA PRINCIPALE -->
                    <HBox alignment="CENTER" spacing="10.0"
                          maxWidth="1100.0">

                        <!-- LOCALITÀ / GEOLOCALIZZAZIONE -->
                        <LuogoInput fx:id="txtLocalita"
                                    minHeight="65.0" prefHeight="65.0" maxHeight="65.0"
                                    maxWidth="1.7976931348623157E308"
                                    HBox.hgrow="ALWAYS"
                                    promptText="Dove? Cerca una città o un indirizzo" />

                        <!-- RICERCA RISTORANTE -->
                        <TextField fx:id="txtRicerca"
                                   minHeight="65.0" prefHeight="65.0" maxHeight="65.0"
                                   maxWidth="1.7976931348623157E308"
                                   HBox.hgrow="ALWAYS"
                                   promptText="Cerca un ristorante..."
                                   styleClass="search-field" />

                        <!-- PULSANTE CERCA -->
                        <Button fx:id="btnCerca"
                                mnemonicParsing="false"
                                onAction="#onRicercaClick"
                                minHeight="65.0" prefHeight="65.0" maxHeight="65.0"
                                prefWidth="125.0"
                                styleClass="flat"
                                text="Cerca" />

                    </HBox>

                    <!-- RICERCA AVANZATA -->
                    <HBox alignment="CENTER_RIGHT" prefWidth="885.0">

                        <Button fx:id="btnRicercaAvanzata" mnemonicParsing="false" onAction="#onRicercaAvanzataClick" prefHeight="50.0" prefWidth="200.0" styleClass="advanced-search" text="Ricerca avanzata" />

                    </HBox>

                </VBox>

            </children>

        </StackPane>
    </center>

</BorderPane>
